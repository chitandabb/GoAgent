# syntax=docker/dockerfile:1.7

FROM golang:1.25-bookworm@sha256:908f8ff2ec296df2f349563072c7925775cd28b50361a52ed834a8a37399b9bf AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/mesguard-knowledge-worker ./cmd/mesguard-knowledge-worker
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/mesguard-layout-routing-eval ./tools/evaluation/mesguard-layout-routing-eval

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/mesguard-knowledge-worker /app/mesguard-knowledge-worker
COPY config /app/config
COPY --from=knowledge_assets /pp-doclayout-m.onnx /app/models/pp-doclayout-m.onnx
COPY --from=knowledge_assets /libonnxruntime.so /app/runtime/libonnxruntime.so
COPY --from=knowledge_assets /asset-manifest.json /app/runtime/asset-manifest.json
COPY --from=knowledge_assets /MODEL_README.md /app/licenses/pp-doclayout-m/README.md
COPY --from=knowledge_assets /ONNXRUNTIME_LICENSE /app/licenses/onnxruntime/LICENSE
COPY --from=knowledge_assets /ONNXRUNTIME_THIRD_PARTY_NOTICES /app/licenses/onnxruntime/ThirdPartyNotices.txt

ARG PP_DOCLAYOUT_M_SHA256=b237c7e4aef235de8f45778ff2dd96dc21480cade40f01435f640b0ff68ee010
ARG ONNXRUNTIME_LIBRARY_SHA256=1461ef7cc3d9e49982591721683cc3e3a55580aeca9a5254e7aac47b75ee4bab
RUN echo "${PP_DOCLAYOUT_M_SHA256}  /app/models/pp-doclayout-m.onnx" | sha256sum -c - \
    && echo "${ONNXRUNTIME_LIBRARY_SHA256}  /app/runtime/libonnxruntime.so" | sha256sum -c -

ENV LD_LIBRARY_PATH=/app/runtime

FROM runtime-base AS evaluation

RUN apt-get update \
    && apt-get install -y --no-install-recommends time \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/mesguard-layout-routing-eval /app/mesguard-layout-routing-eval
COPY testdata/layout-routing-public-v1.corpus.json /app/testdata/layout-routing-public-v1.corpus.json
COPY testdata/layout-routing-public-v1.jsonl /app/testdata/layout-routing-public-v1.jsonl
USER 65532:65532

FROM runtime-base AS final

USER 65532:65532
CMD ["./mesguard-knowledge-worker"]
