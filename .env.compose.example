# Copy this file to .env for local Docker Compose and direct Go/GoLand runs.
# The Go configuration loader reads .env from the process working directory.
# Existing system, GoLand Run Configuration, and Docker-provided variables
# take precedence over values in this file.
# The default values are local-development values only. Do not reuse them in a
# shared or production environment.

# MESGuard target infrastructure
MESGUARD_POSTGRES_USER=mesguard
MESGUARD_POSTGRES_PASSWORD=mesguard_dev_password
MESGUARD_POSTGRES_DB=mesguard
MESGUARD_POSTGRES_PORT=5432
MESGUARD_SQLSERVER_PORT=1433
MESGUARD_SQLSERVER_SA_PASSWORD=MESGuard_Dev!2026
MESGUARD_REDIS_PORT=6379

# Optional host bind mounts. Leave commented to use Docker named volumes.
# MESGUARD_POSTGRES_DATA=D:/develop/docker_workspace/mesguard/postgres
# MESGUARD_SQLSERVER_DATA=D:/develop/docker_workspace/mesguard/sqlserver
# MESGUARD_REDIS_DATA=D:/develop/docker_workspace/mesguard/redis

# Optional LLM credentials. They are not required until Agent execution is
# enabled; never commit real values.
# OPENAI_API_KEY=
