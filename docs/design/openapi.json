{
  "openapi": "3.0.3",
  "info": {
    "title": "MESGuard API",
    "version": "0.1.0-p7-admin-recovery",
    "description": "MESGuard 当前 HTTP API、TaskEvent SSE 与管理员失败恢复契约；JSON 接口统一使用 `code/message/data/requestId` 响应信封。"
  },
  "servers": [
    { "url": "http://localhost:9090" }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["System"],
        "summary": "健康检查",
        "responses": {
          "200": {
            "description": "服务健康",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Response" },
                "examples": {
                  "ok": {
                    "value": {
                      "code": 0,
                      "message": "success",
                      "data": { "status": "ok" }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "依赖不可用",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },

    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "用户登录",
        "description": "校验用户名密码，创建服务端 Session，返回原始 Token 和 CSRF Token。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" },
                "examples": {
                  "success": {
                    "value": {
                      "code": 0,
                      "message": "success",
                      "data": {
                        "user": {
                          "id": "01964f6e-7c3a-7d3f-9c4b-123456789abc",
                          "username": "admin",
                          "displayName": "系统管理员",
                          "role": "admin",
                          "mustChangePassword": false
                        },
                        "csrfToken": "AbCdEfGhIjKlMnOpQrStUvWxYz0123456789",
                        "idleExpiresAt": "2026-07-29T14:00:00Z",
                        "absoluteExpiresAt": "2026-07-30T02:00:00Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误（用户名或密码为空、长度超限）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "validation": {
                    "value": {
                      "code": 40001,
                      "message": "请求参数错误",
                      "data": {
                        "fields": {
                          "username": "必须包含 1 到 64 个字符"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "用户名或密码错误（用户不存在、密码错误、账号禁用返回相同信息）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "bad_credentials": {
                    "value": {
                      "code": 40101,
                      "message": "用户名或密码错误"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "请求 Origin 不在允许列表中",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "服务端内部错误",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },

    "/api/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "获取当前登录用户信息",
        "description": "需要 Session Cookie 和有效的 CSRF Token。返回当前用户信息和 CSRF Token（可用于前端刷新）。",
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "未登录或 Session 已过期",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "CSRF Token 校验失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "服务端内部错误",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },

    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "用户登出",
        "description": "撤销当前 Session，清除 Cookie。需要有效的 Session Cookie、CSRF Token 和可信 Origin。",
        "responses": {
          "200": {
            "description": "登出成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LogoutResponse" }
              }
            }
          },
          "401": {
            "description": "未登录或 Session 已过期",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Origin 不在白名单或 CSRF Token 校验失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "服务端内部错误",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },

    "/api/v1/diagnosis-tasks/{taskId}/events": {
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "afterSeq",
          "in": "query",
          "description": "排他游标，只读取 seq 大于该值的事件",
          "schema": { "type": "integer", "format": "int64", "minimum": 0, "default": 0 }
        },
        {
          "name": "Last-Event-ID",
          "in": "header",
          "description": "SSE 重连游标；提供时优先于 afterSeq",
          "schema": { "type": "string", "pattern": "^[0-9]+$" }
        },
        {
          "name": "limit",
          "in": "query",
          "description": "单次 JSON 页或 SSE 补读批次的最大事件数",
          "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 }
        }
      ],
      "get": {
        "tags": ["Diagnosis Tasks"],
        "summary": "查询或持续订阅任务事件",
        "description": "application/json 返回游标页；text/event-stream 从 PostgreSQL 补读并轮询新事件，终态事件后关闭，断线不取消任务。",
        "responses": {
          "200": {
            "description": "JSON 事件页或 SSE 事件流",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiagnosisTaskEventsResponse" }
              },
              "text/event-stream": {
                "schema": { "type": "string" },
                "example": "retry: 3000\n\nid: 19\nevent: task_started\ndata: {\"seq\":19,\"eventType\":\"task_started\",\"payload\":{\"attemptCount\":1},\"payloadSchemaVersion\":1,\"createdAt\":\"2026-08-03T06:00:00Z\"}\n\n"
              }
            }
          },
          "400": { "description": "任务 ID、游标或批次大小非法", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "未登录", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "无权查看该任务", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "任务不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "事件读取失败", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },

    "/api/v1/diagnosis-tasks/{taskId}/report": {
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Diagnosis Reports"],
        "summary": "查询正式诊断报告",
        "description": "任务创建者和管理员可以读取 Worker 已提交的结构化报告与证据声明元数据；不返回完整证据内容、原始 Prompt、模型推理或原始 SQL。",
        "responses": {
          "200": {
            "description": "正式诊断报告",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiagnosisReportResponse" }
              }
            }
          },
          "400": { "description": "任务 ID 非法", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "未登录", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "无权查看该任务", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "任务不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "任务当前没有可读取的正式报告", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "报告持久化结构无效", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },

    "/api/v1/admin/diagnosis-tasks/{taskId}/recover": {
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "tags": ["Diagnosis Tasks"],
        "summary": "管理员恢复可重试的失败诊断任务",
        "description": "仅恢复 agent_execution_failed；任务、task_requeued、恢复审计和原 Outbox 重开在同一事务提交。恢复保留 attemptCount，下一次 Worker Claim 时再增加。",
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DiagnosisTaskRecoveryRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "幂等重放原恢复结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiagnosisTaskRecoveryResponse" } } } },
          "202": { "description": "恢复事务已提交", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiagnosisTaskRecoveryResponse" } } } },
          "400": { "description": "任务 ID、幂等键或请求体非法", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "未登录", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "非管理员或 CSRF 校验失败", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "任务不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "幂等冲突或任务不可恢复", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "恢复原因不合法", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "服务端内部错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },

    "/api/v1/diagnosis-reports/{reportId}/reviews": {
      "parameters": [
        {
          "name": "reportId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Diagnosis Reports"],
        "summary": "查询报告反馈",
        "description": "任务创建者和管理员可以查看追加保存的反馈历史，current 表示按创建时间倒序的最新反馈。",
        "responses": {
          "200": {
            "description": "反馈历史",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportReviewsResponse" }
              }
            }
          },
          "401": { "description": "未登录", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "无权查看该报告", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "报告不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "服务端内部错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "tags": ["Diagnosis Reports"],
        "summary": "提交报告反馈",
        "description": "只有诊断任务创建者可以追加反馈。接口不覆盖历史记录，不回写 MES/ERP。",
        "parameters": [
          { "$ref": "#/components/parameters/CSRFToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReportReviewRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "反馈已追加",
            "headers": {
              "Location": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportReviewResponse" }
              }
            }
          },
          "400": { "description": "报告 ID 或反馈参数错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "未登录", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "无权提交反馈或 CSRF 校验失败", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "报告不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "反馈内容不合法", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "服务端内部错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  },

  "components": {
    "schemas": {
      "Response": {
        "type": "object",
        "properties": {
          "code":      { "type": "integer", "description": "应用错误码，0 表示成功" },
          "message":   { "type": "string",  "description": "人类可读的消息" },
          "data":      { "type": "object", "description": "响应数据（成功时存在）" },
          "requestId": { "type": "string",  "description": "请求追踪 ID" }
        },
        "required": ["code", "message"]
      },

      "ErrorResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Response" },
          {
            "type": "object",
            "properties": {
              "code":    { "type": "integer", "enum": [40001, 40101, 40301, 40401, 40501, 40901, 40921, 42201, 50000, 50301] },
              "message": { "type": "string" },
              "data": {
                "type": "object",
                "properties": {
                  "fields": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "description": "字段级校验错误（仅 4xx 且非 401/403 时返回）"
                  }
                }
              }
            }
          }
        ]
      },

      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "maxLength": 64,  "description": "登录用户名" },
          "password": { "type": "string", "maxLength": 256, "description": "登录密码" }
        },
        "required": ["username", "password"]
      },

      "AuthUserResponse": {
        "type": "object",
        "description": "脱敏后的用户信息（不包含密码哈希、Token 等敏感字段）",
        "properties": {
          "id":                 { "type": "string", "format": "uuid", "description": "用户 ID" },
          "username":           { "type": "string", "description": "登录用户名" },
          "displayName":        { "type": "string", "description": "显示名称" },
          "role":               { "type": "string", "enum": ["analyst", "admin"], "description": "用户角色" },
          "mustChangePassword": { "type": "boolean", "description": "首次登录后是否必须修改密码" }
        },
        "required": ["id", "username", "displayName", "role", "mustChangePassword"]
      },

      "LoginResponseData": {
        "type": "object",
        "properties": {
          "user":              { "$ref": "#/components/schemas/AuthUserResponse" },
          "csrfToken":         { "type": "string", "description": "CSRF 令牌，前端需保存并在写请求时放到 X-CSRF-Token 头" },
          "idleExpiresAt":     { "type": "string", "format": "date-time", "description": "空闲过期时间（2 小时无操作后 Session 失效）" },
          "absoluteExpiresAt": { "type": "string", "format": "date-time", "description": "绝对过期时间（最多 12 小时后 Session 强制失效）" }
        },
        "required": ["user", "csrfToken", "idleExpiresAt", "absoluteExpiresAt"]
      },

      "LoginResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Response" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/LoginResponseData" }
            }
          }
        ]
      },

      "LogoutResponse": {
        "type": "object",
        "properties": {
          "code":      { "type": "integer", "example": 0 },
          "message":   { "type": "string", "example": "success" },
          "requestId": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "loggedOut": { "type": "boolean", "example": true }
            },
            "required": ["loggedOut"]
          }
        },
        "required": ["code", "message"]
      },

      "DiagnosisReportUsage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "modelCalls": { "type": "integer", "minimum": 0 },
          "promptTokens": { "type": "integer", "minimum": 0 },
          "completionTokens": { "type": "integer", "minimum": 0 },
          "totalTokens": { "type": "integer", "minimum": 0 },
          "cachedTokens": { "type": "integer", "minimum": 0 },
          "reasoningTokens": { "type": "integer", "minimum": 0 }
        },
        "required": ["modelCalls", "promptTokens", "completionTokens", "totalTokens", "cachedTokens", "reasoningTokens"]
      },

      "DiagnosisTaskEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": { "type": "integer", "format": "int64", "minimum": 1 },
          "eventType": { "type": "string" },
          "payload": { "type": "object", "additionalProperties": true },
          "payloadSchemaVersion": { "type": "integer", "minimum": 1 },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["seq", "eventType", "payload", "payloadSchemaVersion", "createdAt"]
      },

      "DiagnosisTaskEventsData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/DiagnosisTaskEvent" } },
          "afterSeq": { "type": "integer", "format": "int64", "minimum": 0 },
          "nextAfterSeq": { "type": "integer", "format": "int64", "minimum": 0 },
          "hasMore": { "type": "boolean" }
        },
        "required": ["items", "afterSeq", "nextAfterSeq", "hasMore"]
      },

      "DiagnosisTaskEventsResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Response" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/DiagnosisTaskEventsData" } },
            "required": ["data"]
          }
        ]
      },

      "DiagnosisTaskRecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "required": ["reason"]
      },

      "DiagnosisTaskRecovery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recoveryId": { "type": "string", "format": "uuid" },
          "taskId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending"] },
          "replayed": { "type": "boolean" },
          "taskEventSeq": { "type": "integer", "format": "int64", "minimum": 1 },
          "previousAttemptCount": { "type": "integer", "minimum": 1 },
          "recoveredAt": { "type": "string", "format": "date-time" }
        },
        "required": ["recoveryId", "taskId", "status", "replayed", "taskEventSeq", "previousAttemptCount", "recoveredAt"]
      },

      "DiagnosisTaskRecoveryResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Response" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/DiagnosisTaskRecovery" } },
            "required": ["data"]
          }
        ]
      },

      "DiagnosisReportEvidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidenceId": { "type": "string", "format": "uuid" },
          "claimKey": { "type": "string" },
          "claim": { "type": "string" },
          "supportType": { "type": "string", "enum": ["supports", "contradicts", "context"] },
          "sourceType": { "type": "string" },
          "sourceRef": { "type": "string" },
          "sourceTool": { "type": "string" },
          "location": { "type": "string" },
          "contentHash": { "type": "string" },
          "collectedAt": { "type": "string", "format": "date-time" },
          "redactionStatus": { "type": "string", "enum": ["not_required", "redacted"] },
          "truncated": { "type": "boolean" },
          "validityStatus": { "type": "string", "enum": ["valid", "superseded", "invalid"] }
        },
        "required": ["evidenceId", "claimKey", "claim", "supportType", "sourceType", "sourceRef", "sourceTool", "contentHash", "collectedAt", "redactionStatus", "truncated", "validityStatus"]
      },

      "DiagnosisReport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reportId": { "type": "string", "format": "uuid" },
          "taskId": { "type": "string", "format": "uuid" },
          "conclusionStatus": { "type": "string", "enum": ["conclusive", "probable", "inconclusive"] },
          "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
          "conclusion": { "type": "string" },
          "businessSummary": { "type": "string" },
          "technicalSummary": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "partial": { "type": "boolean" },
          "missingEvidence": { "type": "array", "items": { "type": "string" } },
          "usage": { "$ref": "#/components/schemas/DiagnosisReportUsage" },
          "agentRuns": { "type": "integer", "minimum": 0 },
          "selectedSkill": { "type": "string" },
          "executedSkills": { "type": "array", "items": { "type": "string" } },
          "stopReason": { "type": "string" },
          "reportSchemaVersion": { "type": "integer", "enum": [1] },
          "modelProvider": { "type": "string" },
          "modelId": { "type": "string" },
          "promptVersion": { "type": "string" },
          "evidence": { "type": "array", "items": { "$ref": "#/components/schemas/DiagnosisReportEvidence" } },
          "generatedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["reportId", "taskId", "conclusionStatus", "riskLevel", "conclusion", "businessSummary", "technicalSummary", "confidence", "limitations", "partial", "missingEvidence", "usage", "agentRuns", "selectedSkill", "executedSkills", "reportSchemaVersion", "modelProvider", "modelId", "promptVersion", "evidence", "generatedAt", "createdAt", "updatedAt"]
      },

      "DiagnosisReportResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Response" },
          { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/DiagnosisReport" } } }
        ]
      },

      "ReportReviewRequest": {
        "type": "object",
        "properties": {
          "verdict": { "type": "string", "enum": ["adopted", "partially_adopted", "rejected"] },
          "comment": { "type": "string", "maxLength": 2000 }
        },
        "required": ["verdict"]
      },

      "ReportReview": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "reportId": { "type": "string", "format": "uuid" },
          "reviewedBy": { "type": "string", "format": "uuid" },
          "verdict": { "type": "string", "enum": ["adopted", "partially_adopted", "rejected"] },
          "comment": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "reportId", "reviewedBy", "verdict", "comment", "createdAt"]
      },

      "ReportReviewResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Response" },
          { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ReportReview" } } }
        ]
      },

      "ReportReviewsData": {
        "type": "object",
        "properties": {
          "reportId": { "type": "string", "format": "uuid" },
          "current": { "allOf": [{ "$ref": "#/components/schemas/ReportReview" }], "nullable": true },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ReportReview" } }
        },
        "required": ["reportId", "current", "items"]
      },

      "ReportReviewsResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Response" },
          { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ReportReviewsData" } } }
        ]
      },

      "Cookie": {
        "type": "object",
        "description": "认证接口返回的 Cookie 信息",
        "properties": {
          "mesguard_session": {
            "type": "object",
            "properties": {
              "HttpOnly": { "type": "boolean", "example": true },
              "SameSite": { "type": "string", "example": "Lax" },
              "Secure":   { "type": "boolean", "example": false },
              "Path":     { "type": "string", "example": "/" }
            }
          },
          "mesguard_csrf": {
            "type": "object",
            "properties": {
              "HttpOnly": { "type": "boolean", "example": false },
              "SameSite": { "type": "string", "example": "Lax" },
              "Secure":   { "type": "boolean", "example": false },
              "Path":     { "type": "string", "example": "/" }
            }
          }
        }
      }
    },

    "parameters": {
      "CSRFToken": {
        "description": "写操作需要携带登录响应或 Cookie 中的 CSRF 令牌",
        "in": "header",
        "name": "X-CSRF-Token",
        "required": true,
        "schema": { "type": "string" }
      },
      "IdempotencyKey": {
        "description": "恢复请求的 UUID 幂等键",
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": { "type": "string", "format": "uuid", "maxLength": 128 }
      }
    },

    "headers": {
      "X-CSRF-Token": {
        "description": "写操作（logout）需要携带的 CSRF 令牌",
        "schema": { "type": "string" }
      },
      "Origin": {
        "description": "请求来源，登录和登出接口要求 Origin 在服务端白名单内",
        "schema": { "type": "string", "format": "uri" }
      }
    },

    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mesguard_session"
      },
      "csrfCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mesguard_csrf"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    }
  },

  "security": [
    { "sessionCookie": [], "csrfCookie": [], "csrfHeader": [] }
  ]
}
