FROM golang:1.25-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/mesguard-api ./cmd/mesguard-api
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/mesguard-migrate ./cmd/mesguard-migrate
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/mesguard-outbox-relay ./cmd/mesguard-outbox-relay
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/mesguard-diagnosis-worker ./cmd/mesguard-diagnosis-worker
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/mesguard-knowledge-worker ./cmd/mesguard-knowledge-worker

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/mesguard-api /app/mesguard-api
COPY --from=builder /out/mesguard-migrate /app/mesguard-migrate
COPY --from=builder /out/mesguard-outbox-relay /app/mesguard-outbox-relay
COPY --from=builder /out/mesguard-diagnosis-worker /app/mesguard-diagnosis-worker
COPY --from=builder /out/mesguard-knowledge-worker /app/mesguard-knowledge-worker
COPY config /app/config

EXPOSE 9090

CMD ["./mesguard-api"]
